{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 4,

  "modules-left": ["dwl/tags", "dwl/window"],
  "modules-center": ["custom/record", "clock"],
  "modules-right": ["tray", "custom/language", "custom/trackpad", "memory", "custom/powerprofile", "custom/suspend", "network", "bluetooth", "pulseaudio#mic", "pulseaudio", "backlight", "custom/chargecap", "battery"],

  "dwl/tags": {
    "num-tags": 9
  },
  "dwl/window": {
    "format": "{title}",
    "max-length": 60
  },

  // Click collapses the clock to a bare icon and back. It can't collapse to
  // nothing: an empty module is hidden by waybar, leaving nothing to click to
  // bring it back. format-alt is toggled by a plain left click, no script.
  // on-click fires on the same click and records the state for gtklock, so one
  // click hides the clock on the bar and on the lock screen.
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "󰅐",
    "on-click": "~/.local/bin/dwl-clock-hide toggle",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  // Empty text while idle, so waybar hides it and the bar looks untouched.
  // Same trick as custom/chargecap. The interval is a self-heal: wf-recorder
  // can die on its own, and only a poll would notice.
  "custom/record": {
    "exec": "~/.local/bin/dwl-record status",
    "return-type": "json",
    "interval": 10,
    "signal": 10,
    "on-click": "~/.local/bin/dwl-record stop",
    "tooltip": true
  },

  // Current input language. Two sources, one module: the xkb layout group
  // (Shift+CapsLock, reported by dwl's kblayout() hook) and the ibus engine
  // (Super+space), with an active IME winning because it sits on top of the
  // layout. Always visible -- there was no layout indicator anywhere before,
  // which made a stray Shift+CapsLock look like a broken punctuation key.
  // Click cycles the input method, same as Super+space.
  "custom/language": {
    "exec": "~/.local/bin/dwl-language status",
    "on-click": "~/.local/bin/dwl-language ime next",
    "return-type": "json",
    "interval": "once",
    "signal": 12,
    "tooltip": true
  },

  // Shown only while the trackpad is muted (Alt+Shift+m -> dwl's togglepointer).
  // Empty text the rest of the time, so waybar hides it -- same trick as
  // custom/chargecap. dwl has no way to push bar state, so the script signals
  // us; "once" plus signal 11 means no polling (8/9/10 are already taken).
  "custom/trackpad": {
    "exec": "~/.local/bin/dwl-trackpad status",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "tooltip": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}/{total:0.1f}G   {swapUsed:0.1f}G",
    "states": { "warning": 80, "critical": 90 },
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },

  "custom/powerprofile": {
    "exec": "~/.local/bin/powerprofile-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/powerprofile-cycle",
    "tooltip": true
  },

  "custom/suspend": {
    "exec": "~/.local/bin/dwl-suspend-status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.local/bin/dwl-suspend-toggle",
    "tooltip": true
  },

  "network": {
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "",
    "tooltip-format": "{status}",
    "format-connected": " {device_alias}",
    "on-click": "blueman-manager"
  },

  // Mic-muted warning, left of the volume. Text only while the default source
  // is muted, empty otherwise so waybar hides it -- the trackpad trick again.
  // A second pulseaudio instance rather than a custom script: it is event-
  // driven, so a mute from the F5 mic key, pavucontrol or wpctl all show up
  // without polling or a signal. format-muted repeats format so muting the
  // *speakers* doesn't make this module say anything. Click unmutes.
  // WirePlumber persists the mute across reboots, so it can sit there unseen
  // for weeks -- which is how a whole webcam recording came out silent.
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-muted": "{format_source}",
    "format-source": "",
    "format-source-muted": "󰍭 mic muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip-format": "Microphone muted -- click or F5 to unmute"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃝", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "custom/chargecap": {
    "exec": "powerctl status --waybar",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "powerctl toggle",
    "tooltip": true
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo} ({power}W)"
  }
}
