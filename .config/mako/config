# Notifications expire after 10s unless the sender asks for a shorter/longer -t.
# (mako's built-in default is 0 = never, which made Firefox popups stick.)
default-timeout=10000

# Firefox asks for "never expire"; override it rather than honouring the request.
[app-name=Firefox]
ignore-timeout=1

# Critical stays until dismissed — the `alarm` command depends on this.
[urgency=critical]
default-timeout=0
ignore-timeout=1
