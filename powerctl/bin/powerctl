#!/bin/sh
# powerctl — battery charging and idle power rules.
#
# Two halves with very different enforcement:
#   charging  SMC firmware enforces sysfs thresholds. Stateless writes, no daemon.
#   idle      swayidle enforces timeouts fixed at launch, so changing them means
#             regenerating its command line and restarting it.
#
# Charging rules need root and live in /etc; idle rules are pure session policy
# and live in ~/.config. Each config sits in the privilege domain it belongs to.

set -eu

CONF=/etc/powerctl/rules.conf

# systemd starts system services with no HOME, and the charging half never needs
# one -- so an unset HOME must not abort the script here, before `apply` has even
# run. Defaulting it to empty keeps every later expansion safe under `set -u`;
# the idle commands, which genuinely need a real home, check for it themselves.
HOME=${HOME:-}
IDLE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/powerctl/idle.conf"
IDLE_CMD="${XDG_STATE_HOME:-$HOME/.local/state}/powerctl/swayidle-cmd.sh"

PROG=${0##*/}

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

# The idle half writes into the user's home and bakes an absolute path to
# dwl-lock into the generated command, so it cannot proceed with HOME unset.
require_home() {
    [ -n "$HOME" ] ||
        die "idle rules need HOME set -- run as your user, not from a system service"
}

# ---------------------------------------------------------------- discovery

# Locate by capability rather than hardcoding macsmc-battery, so this keeps
# working if the driver is ever renamed.
find_battery() {
    for d in /sys/class/power_supply/*/; do
        if [ -f "$d/charge_control_end_threshold" ]; then
            printf '%s' "${d%/}"
            return 0
        fi
    done
    return 1
}

find_ac() {
    for d in /sys/class/power_supply/*/; do
        if [ -f "$d/online" ] && [ "$(cat "$d/type" 2>/dev/null)" = Mains ]; then
            printf '%s' "${d%/}"
            return 0
        fi
    done
    return 1
}

BAT=$(find_battery) || BAT=
AC=$(find_ac) || AC=

on_ac() {
    [ -n "$AC" ] || return 1
    [ "$(cat "$AC/online" 2>/dev/null || echo 0)" = 1 ]
}

# ------------------------------------------------------------------- config

# Charging defaults. CAP_STOP is the cap; CAP_START is where charging resumes.
ACTIVE=none
CAP_START=75
CAP_STOP=80
HEALTH_FLOOR=60
HEALTH_CEILING=90
CHEMISTRY=li-ion

# Idle defaults, seconds; 0 means never. These mirror the values that were
# hardcoded in ~/.config/dwl/startup.sh before powerctl existed.
IDLE_AC_SCREEN=600
IDLE_AC_SLEEP=0
IDLE_BAT_SCREEN=180
IDLE_BAT_SLEEP=600

# shellcheck source=/dev/null
[ -r "$CONF" ]      && . "$CONF"
# shellcheck source=/dev/null
[ -r "$IDLE_CONF" ] && . "$IDLE_CONF"

need_root() {
    [ "$(id -u)" = 0 ] && return 0
    command -v sudo >/dev/null || die "must be root"
    exec sudo -- "$0" "$@"
}

# Rewrite a KEY=value line in a config file, appending if absent.
set_key() { # file key value
    _f=$1 _k=$2 _v=$3
    mkdir -p "${_f%/*}"
    [ -e "$_f" ] || : > "$_f"
    if grep -qE "^[[:space:]]*$_k=" "$_f"; then
        sed -i "s|^[[:space:]]*$_k=.*|$_k=$_v|" "$_f"
    else
        printf '%s=%s\n' "$_k" "$_v" >> "$_f"
    fi
}

# ------------------------------------------------------------------- health

soh() { # state of health, integer percent
    _f=$(cat "$BAT/charge_full" 2>/dev/null || echo 0)
    _d=$(cat "$BAT/charge_full_design" 2>/dev/null || echo 0)
    [ "$_d" -gt 0 ] || return 1
    echo $(( _f * 100 / _d ))
}

# Policy, not a computation -- the hardware reports condition, not what to do
# about it. See docs/powerctl.md. The inversion at low SoH is deliberate: once a
# pack has lost real capacity, capping the top slice costs more utility than the
# marginal aging benefit is worth.
health_target() { # soh -> target percent
    if   [ "$1" -ge 90 ]; then _t=75
    elif [ "$1" -ge 80 ]; then _t=80
    elif [ "$1" -ge 70 ]; then _t=85
    else                       _t=90
    fi
    [ "$_t" -lt "$HEALTH_FLOOR" ]   && _t=$HEALTH_FLOOR
    [ "$_t" -gt "$HEALTH_CEILING" ] && _t=$HEALTH_CEILING
    echo "$_t"
}

# Resolve the active rule to a start/stop pair. Prints "start stop".
effective_thresholds() {
    case $ACTIVE in
        cap)    echo "$CAP_START $CAP_STOP" ;;
        health)
            _s=$(soh) || die "cannot read battery health"
            _t=$(health_target "$_s")
            _b=$(( _t - 5 )); [ "$_b" -lt 0 ] && _b=0
            echo "$_b $_t"
            ;;
        none|*) echo "100 100" ;;
    esac
}

# ---------------------------------------------------------------- appliance

# UPower 1.91 has its own charge limit (readonly 75/80). Harmless while
# disabled, but it writes the same sysfs files, so make sure it stays off.
upower_guard() {
    command -v upower >/dev/null || return 0
    command -v busctl >/dev/null || return 0
    _p=$(upower -e 2>/dev/null | grep -m1 battery) || return 0
    _en=$(busctl get-property org.freedesktop.UPower "$_p" \
              org.freedesktop.UPower.Device ChargeThresholdEnabled 2>/dev/null |
          awk '{print $2}')
    [ "$_en" = "true" ] || return 0
    if ! busctl call org.freedesktop.UPower "$_p" \
             org.freedesktop.UPower.Device EnableChargeThreshold b false \
             >/dev/null 2>&1; then
        warn "UPower's charge limit is enabled and could not be turned off;" \
             "it will fight powerctl over the same sysfs files"
    fi
}

# UDEV_LIBDIR is a variable only so the guard below can be exercised against a
# fixture; nothing sets it in normal use.
UDEV_LIBDIR=${UDEV_LIBDIR:-/usr/lib/udev/rules.d}

# A udev rule that writes the charge-threshold attributes is the worst kind of
# competing writer: it re-applies its own stored value on EVERY power_supply
# uevent, so it reverts whatever powerctl just wrote within milliseconds --
# including the 100/100 that `off` writes. The symptom is a cap that ignores
# every command while `list` reports drift.
#
# Matched on behaviour rather than package name. Fedora's asahi-battery ships
# one today, but the failure mode belongs to the mechanism, not the package.
#
# Cannot be fixed from here: udev rules are system configuration and disabling
# one is the user's call, so this only reports. udev collects rules by filename
# across /etc, /run and /usr/lib and the highest-priority directory wins, so an
# empty same-named file in /etc neutralises a packaged rule without removing it.
udev_guard() {
    [ -d "$UDEV_LIBDIR" ] || return 0
    _hits=
    for _f in "$UDEV_LIBDIR"/*.rules; do
        [ -f "$_f" ] || continue
        # Assignment only. udev writes with `=` or `:=` and merely tests with
        # `==` / `!=`, and rules that test these attributes are common and
        # harmless -- upower's own 60-upower-battery.rules does exactly that.
        grep -qE 'ATTR\{charge_control_[a-z_]+\}[[:space:]]*:?=[^=]' "$_f" \
            2>/dev/null || continue
        _n=${_f##*/}
        # Shadowed by a higher-priority directory means it never runs.
        if [ ! -e "/etc/udev/rules.d/$_n" ] && [ ! -e "/run/udev/rules.d/$_n" ]; then
            _hits="${_hits:+$_hits }$_n"
        fi
    done
    for _n in $_hits; do
        warn "udev rule $_n also writes the charge thresholds and will revert" \
             "powerctl on the next power_supply event"
        warn "  neutralise: sudo touch /etc/udev/rules.d/$_n &&" \
             "sudo udevadm control --reload"
    done
}

# powerdevil ships a root KAuth helper (chargethresholdhelper) that writes the
# same sysfs files. D-Bus activates it on demand, so it can only interfere while
# powerdevil itself is running -- in practice, inside a Plasma session. Matched
# on the full command line because the binary name is longer than the 15
# characters `comm` keeps.
powerdevil_guard() {
    command -v pgrep >/dev/null || return 0
    pgrep -f org_kde_powerdevil >/dev/null 2>&1 || return 0
    warn "powerdevil is running and writes the same charge thresholds;" \
         "turn its charge limit off in Plasma's power settings"
}

# The driver rejects start > stop, so pick the write order that keeps every
# intermediate state valid rather than assuming a direction.
write_thresholds() { # start stop
    _ns=$1 _nt=$2
    _ce=$(cat "$BAT/charge_control_end_threshold")
    if [ "$_ns" -le "$_ce" ]; then
        printf '%s\n' "$_ns" > "$BAT/charge_control_start_threshold"
        printf '%s\n' "$_nt" > "$BAT/charge_control_end_threshold"
    else
        printf '%s\n' "$_nt" > "$BAT/charge_control_end_threshold"
        printf '%s\n' "$_ns" > "$BAT/charge_control_start_threshold"
    fi
}

cmd_apply() {
    [ -n "$BAT" ] || die "no battery with charge-threshold support"
    need_root apply "$@"

    # Report-only guards run on the restore path too. `off` writing 100/100 is
    # exactly as revertible as a cap, and that is the case that actually bit:
    # the cap read as disabled everywhere while the hardware stayed pinned.
    # upower_guard is not here because it *changes* something, and an uninstall
    # (`apply --restore`) has no business turning off someone else's setting.
    udev_guard
    powerdevil_guard

    if [ "${1:-}" = --restore ]; then
        set -- 100 100
    else
        upower_guard
        # shellcheck disable=SC2046
        set -- $(effective_thresholds)
    fi

    write_thresholds "$1" "$2"

    # The driver may silently clamp; report drift rather than assume success.
    _gs=$(cat "$BAT/charge_control_start_threshold")
    _ge=$(cat "$BAT/charge_control_end_threshold")
    if [ "$_gs" != "$1" ] || [ "$_ge" != "$2" ]; then
        warn "driver clamped thresholds: asked $1/$2, got $_gs/$_ge"
    fi
}

# ------------------------------------------------------------------ duration

# A unit is mandatory. A bare number is rejected rather than guessed at: read as
# seconds it blanks the screen half a minute in, read as minutes it does nothing
# for half an hour, and neither reading is obviously wrong from the outside.
parse_dur() {
    case $1 in
        never|off|none|always) echo 0; return 0 ;;
    esac

    # Split the trailing unit from the magnitude and validate both, so junk like
    # `5xh` gives a duration error rather than a raw arithmetic one.
    _u=${1#"${1%?}"} _n=${1%?}
    case $_n in ''|*[!0-9]*) die "bad duration: $1 (use 45s, 5m, 1h, or never)" ;; esac

    case $_u in
        h) echo $(( _n * 3600 )) ;;
        m) echo $(( _n * 60 )) ;;
        s) echo "$_n" ;;
        *) die "bad duration: $1 (use 45s, 5m, 1h, or never)" ;;
    esac
}

fmt_dur() {
    [ "$1" -eq 0 ] && { echo never; return 0; }
    if   [ $(( $1 % 3600 )) -eq 0 ]; then echo "$(( $1 / 3600 ))h"
    elif [ $(( $1 % 60 ))   -eq 0 ]; then echo "$(( $1 / 60 ))m"
    else                                  echo "${1}s"
    fi
}

# Sleep has precedence: when a source suspends at or before its own screen
# timeout, the suspend owns the idle period and the screen rule never runs --
# suspending blanks the display anyway, and swayidle's before-sleep hook has
# already locked. powerctl-idle-action enforces this; the reporting below exists
# so a screen rule that can never fire is visible rather than silently dead.
shadowed() { # screen sleep
    [ "$2" -gt 0 ] && [ "$2" -le "$1" ]
}

_warn_shadow_one() { # label screen sleep
    shadowed "$2" "$3" || return 0
    warn "$1: suspend at $(fmt_dur "$3") pre-empts the $(fmt_dur "$2") screen timeout -- the screen rule never fires"
}

# Not an error -- hand-tuning freely is the point, and this is a legitimate
# setting if you only ever wanted the machine to sleep.
warn_shadow() {
    _warn_shadow_one 'on AC'   "$IDLE_AC_SCREEN"  "$IDLE_AC_SLEEP"
    _warn_shadow_one 'battery' "$IDLE_BAT_SCREEN" "$IDLE_BAT_SLEEP"
}

# --------------------------------------------------------------------- idle

# Register the union of all configured timeouts and let the handler decide
# whether each applies. Restarting swayidle resets its idle counter, so this
# deliberately avoids needing a restart when the power source changes -- only a
# config change regenerates this.
gen_idle_cmd() {
    mkdir -p "${IDLE_CMD%/*}"
    {
        printf '#!/bin/sh\n'
        printf '# Generated by powerctl -- do not edit. Regenerate: powerctl idle apply\n'
        printf 'exec swayidle -w \\\n'

        for _spec in "screen $IDLE_AC_SCREEN" "screen $IDLE_BAT_SCREEN" \
                     "sleep $IDLE_AC_SLEEP"   "sleep $IDLE_BAT_SLEEP"; do
            # shellcheck disable=SC2086
            set -- $_spec
            _kind=$1 _secs=$2
            [ "$_secs" -gt 0 ] || continue
            # A screen timeout shadowed by sleep is still registered: the same
            # number may be live for the other power source, and the handler
            # is where that gets decided.
            # dedupe: same kind+timeout registered twice would fire twice
            case " ${_seen:-} " in *" $_kind:$_secs "*) continue ;; esac
            _seen="${_seen:-} $_kind:$_secs"

            # Single-quoted printf formats: the generated file needs real
            # backslash-newline continuations, and a double-quoted format here
            # consumes the escapes one level too early.
            printf "  timeout %s 'powerctl-idle-action %s %s'" \
                   "$_secs" "$_kind" "$_secs"
            if [ "$_kind" = screen ]; then
                printf ' \\\n'
                # Never a bare wlopm --on: waking the panel too soon after the
                # blank wedges apple-dcp. The handler holds it back.
                printf '    resume %s' "'powerctl-idle-action wake'"
            fi
            printf ' \\\n'
        done

        printf '  before-sleep %s' "'$HOME/.local/bin/dwl-lock'"
        printf ' \\\n'
        printf '  after-resume %s\n' "'wlopm --on \"*\"'"
    } > "$IDLE_CMD"
    chmod +x "$IDLE_CMD"
}

idle_row() { # label screen sleep
    if shadowed "$2" "$3"; then
        printf '  %-10s %-10s %-10s%s\n' "$1" "$(fmt_dur "$2")" "$(fmt_dur "$3")" \
               '<- screen rule never fires'
    else
        printf '  %-10s %-10s %s\n' "$1" "$(fmt_dur "$2")" "$(fmt_dur "$3")"
    fi
}

cmd_idle() {
    case ${1:-show} in
    show)
        printf 'idle rules   (live source: %s)\n\n' "$(on_ac && echo AC || echo battery)"
        printf '  %-10s %-10s %s\n' '' 'screen' 'sleep'
        idle_row 'on AC'   "$IDLE_AC_SCREEN"  "$IDLE_AC_SLEEP"
        idle_row 'battery' "$IDLE_BAT_SCREEN" "$IDLE_BAT_SLEEP"

        _any_shadow=no
        shadowed "$IDLE_AC_SCREEN"  "$IDLE_AC_SLEEP"  && _any_shadow=yes
        shadowed "$IDLE_BAT_SCREEN" "$IDLE_BAT_SLEEP" && _any_shadow=yes
        if [ "$_any_shadow" = yes ]; then
            printf '\n  sleep has precedence: the system suspends at or before the screen\n'
            printf '  timeout, so the screen rule never runs. Give sleep the longer\n'
            printf '  timeout of the two if you want both.\n'
        fi

        if [ -e "$HOME/.local/state/dwl/no-suspend" ]; then
            printf '\n  override: idle suspend OFF (dwl-suspend-toggle)\n'
            [ "$_any_shadow" = yes ] &&
                printf '            while it holds, shadowed screen rules DO fire\n'
        fi
        ;;
    set)
        require_home
        # Three forms. Omitting the source sets both, since "screen off after
        # 15 minutes" is usually a single intent rather than two.
        case $# in
        3)  case $2 in
                ac|bat|both|all)
                    die "usage: $PROG idle set $2 <screen|sleep> <duration>" ;;
            esac
            _srcs='ac bat' _what=$2 _dur=$3
            ;;
        4)  case $2 in
                ac|bat)   _srcs=$2 ;;
                both|all) _srcs='ac bat' ;;
                *) die "expected 'ac', 'bat' or 'both', got: $2" ;;
            esac
            _what=$3 _dur=$4
            ;;
        *)  die "usage: $PROG idle set [ac|bat|both] <screen|sleep> <45s|5m|1h|never>" ;;
        esac
        case $_what in screen|sleep) ;; *) die "expected 'screen' or 'sleep', got: $_what" ;; esac

        _val=$(parse_dur "$_dur")
        _field=$(echo "$_what" | tr '[:lower:]' '[:upper:]')
        for _s in $_srcs; do
            _key="IDLE_$(echo "$_s" | tr '[:lower:]' '[:upper:]')_$_field"
            set_key "$IDLE_CONF" "$_key" "$_val"
            # Keep the in-memory copy in step. gen_idle_cmd reads these
            # variables, not the file, so without this it would regenerate
            # swayidle from the values sourced at startup -- writing the new
            # timeout to disk while quietly still enforcing the old one.
            eval "$_key=\$_val"
            printf '%s = %s\n' "$_key" "$(fmt_dur "$_val")"
        done
        cmd_idle apply
        warn_shadow
        ;;
    apply)
        require_home
        gen_idle_cmd
        systemctl --user restart swayidle.service 2>/dev/null ||
            warn "could not restart swayidle.service (not installed yet?)"
        ;;
    *) die "unknown idle subcommand: $1" ;;
    esac
}

# ---------------------------------------------------------------------- lid

# The lid is logind's, not swayidle's -- a third enforcer with its own config
# and its own privilege domain. Two things make this tractable: logind is
# Type=notify-reload, so a change applies on `systemctl reload` without
# restarting it and disturbing the session; and it publishes the live policy on
# D-Bus, so there is no need to keep a shadow copy in rules.conf and no way for
# one to drift. The drop-in is the config; logind is the source of truth.
LID_CONF=/etc/systemd/logind.conf.d/50-powerctl-lid.conf

lid_prop() { # property -> value, empty if unset
    command -v busctl >/dev/null || return 1
    busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
           org.freedesktop.login1.Manager "$1" 2>/dev/null | awk -F'"' '{print $2}'
}

# Prints "ac bat". An unset HandleLidSwitchExternalPower means "same as
# HandleLidSwitch", so resolve the inheritance here rather than reporting blank.
lid_live() {
    _b=$(lid_prop HandleLidSwitch) || return 1
    [ -n "$_b" ] || return 1
    _a=$(lid_prop HandleLidSwitchExternalPower)
    [ -n "$_a" ] || _a=$_b
    printf '%s %s\n' "$_a" "$_b"
}

# logind takes more actions than powerctl sets (lock, hibernate, poweroff...).
# Anything we did not write is echoed verbatim instead of forced into on/off.
lid_word() {
    case $1 in
        suspend) echo 'sleeps' ;;
        ignore)  echo 'stays awake' ;;
        *)       echo "$1" ;;
    esac
}

cmd_lid() {
    case ${1:-show} in
    show)
        if ! _l=$(lid_live); then
            printf 'lid close    unavailable (cannot reach logind)\n'
            return 0
        fi
        # shellcheck disable=SC2086
        set -- $_l
        printf 'lid close\n\n'
        printf '  %-10s %s\n' 'on AC'   "$(lid_word "$1")"
        printf '  %-10s %s\n' 'battery' "$(lid_word "$2")"

        # Easy to miss, and it makes a configured "sleeps" look broken: with an
        # external display attached, logind treats the machine as docked and
        # this setting is bypassed entirely.
        _d=$(lid_prop HandleLidSwitchDocked) || _d=
        if [ "${_d:-ignore}" = ignore ]; then
            printf '\n  with an external display attached, lid close is ignored\n'
            printf '  regardless of the above (logind HandleLidSwitchDocked=%s)\n' \
                   "${_d:-ignore}"
        fi
        ;;
    *)
        case $# in
        1)  _srcs='ac bat' _act=$1 ;;
        2)  case $1 in
                ac|bat)   _srcs=$1 ;;
                both|all) _srcs='ac bat' ;;
                *) die "expected 'ac', 'bat' or 'both', got: $1" ;;
            esac
            _act=$2
            ;;
        *)  die "usage: $PROG lid [ac|bat|both] <on|off>" ;;
        esac
        case $_act in
            on|sleep|suspend)  _act=suspend ;;
            off|ignore|never)  _act=ignore ;;
            *) die "expected 'on' or 'off', got: $_act" ;;
        esac

        need_root lid "$@"

        # Rewrite both keys from the live pair, so the drop-in always states the
        # whole policy and never leans on logind's inheritance rules.
        _cur=$(lid_live) || die "cannot read current lid policy from logind"
        # shellcheck disable=SC2086
        set -- $_cur
        _ac=$1 _bat=$2
        for _s in $_srcs; do
            case $_s in ac) _ac=$_act ;; bat) _bat=$_act ;; esac
        done

        mkdir -p "${LID_CONF%/*}"
        {
            printf '# Generated by powerctl -- do not edit.\n'
            printf '# Change with: powerctl lid [ac|bat|both] <on|off>\n'
            printf '[Login]\n'
            printf 'HandleLidSwitch=%s\n' "$_bat"
            printf 'HandleLidSwitchExternalPower=%s\n' "$_ac"
        } > "$LID_CONF"

        systemctl reload systemd-logind ||
            warn "could not reload systemd-logind; the new policy applies at next boot"

        # A drop-in sorting after ours would silently outrank it.
        _new=$(lid_live) || _new=
        if [ -n "$_new" ] && [ "$_new" != "$_ac $_bat" ]; then
            warn "logind reports '$_new', not '$_ac $_bat' --" \
                 "another drop-in may outrank $LID_CONF"
        fi
        cmd_lid show
        ;;
    esac
}

# ------------------------------------------------------------------- output

cmd_list() {
    # "active" here names the selected rule, not whether it is being applied --
    # two separate switches, and reporting only the first made a rule that had
    # just been paused from the bar read as if nothing had happened.
    if [ "$ACTIVE" = none ] || enforced; then
        printf 'charging rules   (active: %s)\n\n' "$ACTIVE"
    else
        printf 'charging rules   (active: %s -- PAUSED, thresholds not applied)\n' "$ACTIVE"
        printf '                  resume with: %s toggle\n\n' "$PROG"
    fi
    printf '  cap       start %s%%  stop %s%%\n' "$CAP_START" "$CAP_STOP"
    if _s=$(soh 2>/dev/null); then
        printf '  health    SoH %s%%  ->  start %s%%  stop %s%%   (floor %s, ceiling %s)\n' \
            "$_s" "$(( $(health_target "$_s") - 5 ))" "$(health_target "$_s")" \
            "$HEALTH_FLOOR" "$HEALTH_CEILING"
    fi

    if [ -n "$BAT" ]; then
        printf '\n  live      start %s%%  stop %s%%  capacity %s%%  %s\n' \
            "$(cat "$BAT/charge_control_start_threshold")" \
            "$(cat "$BAT/charge_control_end_threshold")" \
            "$(cat "$BAT/capacity")" "$(cat "$BAT/status")"
        # Configured and live diverging is the main silent failure mode here --
        # but the rule is only what the hardware *should* read while enforcement
        # is on. Paused, 100/100 is the correct reading, and comparing against
        # the rule anyway told the user to run `powerctl apply`, which silently
        # re-applies the rule they had just paused.
        if enforced; then
            # shellcheck disable=SC2046
            set -- $(effective_thresholds)
            _why="live values do not match the rule ($1/$2) -- run: $PROG apply"
        else
            set -- 100 100
            _why="live values do not match the paused state (100/100) -- run:"
            _why="$_why $PROG toggle to resume the rule, or $PROG apply --restore"
        fi
        if [ "$(cat "$BAT/charge_control_start_threshold")" != "$1" ] ||
           [ "$(cat "$BAT/charge_control_end_threshold")" != "$2" ]; then
            printf '  WARNING   %s\n' "$_why"
        fi
    fi

    printf '\n'
    cmd_idle show
    printf '\n'
    cmd_lid show
}

UNIT=powerctl.service

# Whether the rule is currently being enforced, as opposed to merely configured.
# The unit's active state is the on/off switch -- see docs/powerctl.md.
enforced() { systemctl is-active --quiet "$UNIT" 2>/dev/null; }

have_unit() {
    command -v systemctl >/dev/null 2>&1 || return 1
    systemctl cat "$UNIT" >/dev/null 2>&1
}

# Every command that changes what *should* be enforced goes through the unit, so
# that the switch keeps telling the truth. Writing sysfs directly instead leaves
# the thresholds genuinely in force while `is-active` still reads inactive, and
# three things read that bit:
#
#   - `status --waybar`, which then reports a live cap as paused;
#   - `list`, which then warns about drift that is not drift;
#   - powerctl-{resume,refresh}.service, both `try-restart` -- a no-op on an
#     inactive unit, so a cap set outside systemd was silently dropped on the
#     next resume.
#
# `toggle` deliberately does NOT use these: it runs unprivileged and relies on
# polkit, so it must never fall back to a path that re-execs sudo.
enforce_on() {
    if have_unit; then
        # cmd_apply runs inside the unit from here, so its competing-writer
        # warnings would only reach the journal. Repeat the report-only ones on
        # the terminal the user is actually looking at.
        udev_guard
        powerdevil_guard
        # restart, not start: re-runs ExecStart when the unit is already active,
        # which is the usual case when only the rule changed.
        if systemctl restart "$UNIT"; then
            return 0
        fi
        warn "could not start $UNIT -- applying directly;" \
             "enforcement will still read as paused"
    fi
    cmd_apply
}

enforce_off() {
    if have_unit && enforced; then
        udev_guard
        powerdevil_guard
        if systemctl stop "$UNIT"; then   # ExecStop restores 100/100
            return 0
        fi
        warn "could not stop $UNIT -- restoring 100/100 directly"
    fi
    cmd_apply --restore
}

cmd_status() {
    if [ "${1:-}" = --waybar ]; then
        # waybar hides a custom module whose text is empty. That is the right
        # answer for "no rule set" and the wrong one for "paused": a hidden
        # module cannot be clicked, and clicking is the only way back from a
        # pause, so pausing from the bar used to remove the control that
        # un-pauses it. Paused renders too -- open padlock, amber.
        if [ "$ACTIVE" = none ]; then
            printf '{"text":"","tooltip":"No charging rule set\\nRun: powerctl cap 80","class":"off"}\n'
            return 0
        fi
        # shellcheck disable=SC2046
        set -- $(effective_thresholds)
        if enforced; then
            printf '{"text":"%s","tooltip":"Charge rule: %s\\nResumes below %s%%, stops at %s%%\\nClick to pause","class":"on"}\n' \
                "$2" "$ACTIVE" "$1" "$2"
        else
            printf '{"text":"󱞝 %s","tooltip":"Charge rule PAUSED (%s: %s%%/%s%%)\\nCharging to 100%% until resumed\\nClick to resume","class":"paused"}\n' \
                "$2" "$ACTIVE" "$1" "$2"
        fi
    else
        # shellcheck disable=SC2046
        set -- $(effective_thresholds)
        printf '%s: start %s%% stop %s%% (%s)\n' \
            "$ACTIVE" "$1" "$2" "$(enforced && echo enforced || echo paused)"
    fi
}

refresh_waybar() { pkill -RTMIN+9 -x waybar 2>/dev/null || true; }

notify() {
    if command -v notify-send >/dev/null; then
        notify-send -t 3000 "powerctl" "$1"
    else
        echo "$1"
    fi
}

# waybar on-click. Deliberately toggles ENFORCEMENT via systemd rather than
# rewriting rules.conf: the polkit rule makes start/stop passwordless, whereas
# `powerctl cap` needs sudo and would hang waiting for a password with no tty.
# Changing which rule applies stays a deliberate CLI action.
cmd_toggle() {
    if [ "$ACTIVE" = none ]; then
        notify "No charging rule set — run: powerctl cap 80"
        return 0
    fi
    if enforced; then
        systemctl stop powerctl.service && _m="Charge rule paused — charges to 100%"
    else
        systemctl start powerctl.service && _m="Charge rule on ($ACTIVE)"
    fi
    refresh_waybar
    notify "${_m:-powerctl: systemctl failed}"
}

usage() {
    cat <<EOF
usage: $PROG <command>

charging
  list                       all rules, live values, drift warnings
  status [--waybar]          one-line summary; --waybar emits JSON
  toggle                     pause/resume enforcement (waybar on-click)
  cap <percent>              set and activate the cap rule
  health [--explain]         activate the SoH-derived rule
  off                        restore 100/100
  apply [--restore]          re-apply current rule (used by systemd)

idle timeouts                                              [swayidle]
  idle                       show screen/sleep timeouts per power source
  idle set <screen|sleep> <duration>                 both power sources
  idle set <ac|bat|both> <screen|sleep> <duration>
  idle apply                 regenerate swayidle command and restart it

  duration is 45s, 5m, 1h, or never (aliases: off, none, always).
  A bare number is rejected -- the unit is never guessed.

  Sleep has precedence: if a source suspends at or before its own screen
  timeout, the screen rule never fires. \`$PROG idle\` flags that.

lid close                                                    [logind]
  lid                        show what closing the lid does, per source
  lid <on|off>                                       both power sources
  lid <ac|bat|both> <on|off>       on = suspend, off = stay awake  [sudo]

  Bypassed while an external display is attached -- logind treats that
  as docked and ignores the lid either way.
EOF
}

# --------------------------------------------------------------------- main

case ${1:-list} in
list)   cmd_list ;;
status) shift; cmd_status "$@" ;;
toggle) cmd_toggle ;;
apply)  shift; cmd_apply "$@" ;;
idle)   shift; cmd_idle "$@" ;;
lid)    shift; cmd_lid "$@" ;;

cap)
    [ $# -eq 2 ] || die "usage: $PROG cap <percent>"
    case $2 in ''|*[!0-9]*) die "not a percentage: $2" ;; esac
    [ "$2" -ge 20 ] && [ "$2" -le 100 ] || die "cap must be 20-100"
    need_root cap "$2"
    _start=$(( $2 - 5 )); [ "$_start" -lt 0 ] && _start=0
    set_key "$CONF" CAP_STOP "$2"
    set_key "$CONF" CAP_START "$_start"
    set_key "$CONF" ACTIVE cap
    ACTIVE=cap CAP_STOP=$2 CAP_START=$_start
    enforce_on
    refresh_waybar
    printf 'cap: start %s%% stop %s%%\n' "$_start" "$2"
    ;;

health)
    if [ "${2:-}" = --explain ]; then
        _s=$(soh) || die "cannot read battery health"
        _t=$(health_target "$_s")
        cat <<EOF
inputs
  charge_full / charge_full_design   $(cat "$BAT/charge_full") / $(cat "$BAT/charge_full_design")
  state of health                    ${_s}%
  cycle count                        $(cat "$BAT/cycle_count" 2>/dev/null || echo n/a)
  chemistry                          $CHEMISTRY (assumed; not readable from hardware)

policy (SoH -> target, clamped to ${HEALTH_FLOOR}-${HEALTH_CEILING})
  >= 90%  -> 75    healthy: spend margin on longevity
  >= 80%  -> 80    the usual compromise
  >= 70%  -> 85    degraded: capping now costs more than it saves
  <  70%  -> 90    worn: prioritise usable runtime

result
  target ${_t}%, resume at $(( _t - 5 ))%

This is a tunable policy, not a derived optimum.
EOF
        exit 0
    fi
    need_root health
    set_key "$CONF" ACTIVE health
    ACTIVE=health
    enforce_on
    refresh_waybar
    cmd_status
    ;;

off)
    need_root off
    set_key "$CONF" ACTIVE none
    ACTIVE=none
    enforce_off
    refresh_waybar
    echo "charge rules off (100/100)"
    ;;

-h|--help|help) usage ;;
*) die "unknown command: $1 (try '$PROG --help')" ;;
esac
