[Unit]
Description=swayidle (idle timeouts generated by powerctl)
Documentation=man:swayidle(1)
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.local/state/powerctl/swayidle-cmd.sh

[Service]
Type=simple
# Generated by `powerctl idle apply` -- a script rather than an argument list so
# swayidle's nested quoting stays readable.
ExecStart=%h/.local/state/powerctl/swayidle-cmd.sh
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
