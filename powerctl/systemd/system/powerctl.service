[Unit]
Description=Battery charging rules
Documentation=file:/etc/powerctl/rules.conf
ConditionPathExistsGlob=/sys/class/power_supply/*/charge_control_end_threshold

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/powerctl apply
ExecStop=/usr/local/bin/powerctl apply --restore

[Install]
WantedBy=multi-user.target
